#include<stdio.h>

#define INF 999
#define MAX 100

int p[MAX], c[MAX][MAX], t[MAX][2];

int find(int v)
{
    while(p[v])
        v=p[v];
    return v;
}

void union1(int i,int j)
{
    p[j]=i;
}

void kruskal(int n)
{
    int i,j,k,u,v,min,res1,res2,sum=0;

    for(k=1;k<n;k++)
    {
        min=INF;
        res1=-1;
        res2=-1;

        for(i=1;i<=n;i++)
        {
            for(j=1;j<=n;j++)
            {
                if(i==j)
                    continue;

                if(c[i][j]<min)
                {
                    u=find(i);
                    v=find(j);

                    if(u!=v)
                    {
                        min=c[i][j];
                        res1=i;
                        res2=j;
                    }
                }
            }
        }

        if(res1==-1)
            break;

        union1(find(res1),find(res2));

        t[k][1]=res1;
        t[k][2]=res2;

        sum+=min;

        c[res1][res2]=INF;
        c[res2][res1]=INF;
    }

    printf("\nCost of Spanning Tree = %d\n",sum);

    printf("\nEdges in MST are:\n");

    for(i=1;i<k;i++)
    {
        printf("%d -> %d\n",t[i][1],t[i][2]);
    }
}

int main()
{
    int i,j,n;

    printf("Enter number of vertices : ");
    scanf("%d",&n);

    for(i=1;i<=n;i++)
        p[i]=0;

    printf("Enter Cost Matrix:\n");

    for(i=1;i<=n;i++)
        for(j=1;j<=n;j++)
            scanf("%d",&c[i][j]);

    kruskal(n);

    return 0;
}
